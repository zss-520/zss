def now_str() -> str:
    return _dt.datetime.now().strftime('%Y-%m-%d %H:%M:%S')

def ensure_parent(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

def json_dumps(obj: Any, indent: Optional[int] = None) -> str:
    return json.dumps(obj, ensure_ascii=False, indent=indent)

def append_jsonl(path: Path, obj: Any) -> None:
    ensure_parent(path)
    with open(path, 'a', encoding='utf-8') as f:
        f.write(json_dumps(obj) + '\n')

def normalize_text(text: str) -> str:
    return re.sub(r'\s+', ' ', html.unescape(str(text or ''))).strip()

def stable_hash(text: str) -> str:
    return hashlib.sha256(str(text or '').encode('utf-8')).hexdigest()[:16]

def normalize_key(text: str) -> str:
    text = normalize_text(text).lower()
    text = re.sub(r'[^a-z0-9\u4e00-\u9fff]+', '_', text)
    return re.sub(r'_+', '_', text).strip('_')[:160]

def truncate(text: str, max_chars: int) -> str:
    text = str(text or '')
    return text if len(text) <= max_chars else text[:max_chars] + '\n...[TRUNCATED]...'

def safe_json_loads(text: str) -> Any:
    if not text:
        raise ValueError('empty JSON')
    cleaned = text.strip()
    cleaned = re.sub(r'^```(?:json)?', '', cleaned, flags=re.I).strip()
    cleaned = re.sub(r'```$', '', cleaned).strip()
    try:
        return json.loads(cleaned)
    except Exception:
        pass
    m = re.search(r'\{[\s\S]*\}', cleaned)
    if m:
        return json.loads(m.group(0))
    m = re.search(r'\[[\s\S]*\]', cleaned)
    if m:
        return json.loads(m.group(0))
    raise ValueError(f'无法解析 JSON，前 500 字符: {cleaned[:500]}')


def load_provider_config(path: Path = DEFAULT_PROVIDER_CONFIG, provider: str = DEFAULT_PROVIDER) -> Dict[str, Any]:
