@dataclass
class PubMedRecord:
    pmid: str
    title: str
    abstract: str
    journal: str = ''
    year: str = ''
    doi: str = ''
    pmcid: str = ''
    authors: List[str] = None
    keywords: List[str] = None
    publication_types: List[str] = None
    article_ids: Dict[str, str] = None

    def __post_init__(self):
        self.authors = self.authors or []
        self.keywords = self.keywords or []
        self.publication_types = self.publication_types or []
        self.article_ids = self.article_ids or {}
        if not self.pmcid:
            self.pmcid = self.article_ids.get('pmc', '') or self.article_ids.get('pmcid', '')

    @property
    def pubmed_url(self) -> str:
        return f'https://pubmed.ncbi.nlm.nih.gov/{self.pmid}/' if self.pmid else ''

    @property
    def title_hash(self) -> str:
        return stable_hash(normalize_text(self.title))

    def to_context(self, max_full: int = 0) -> str:
        return (
            f"PMID: {self.pmid}\nPMCID: {self.pmcid or 'N/A'}\nDOI: {self.doi or 'N/A'}\n"
            f"Title: {self.title}\nJournal: {self.journal or 'N/A'}\nYear: {self.year or 'N/A'}\n"
            f"Authors: {', '.join(self.authors[:10]) or 'N/A'}\n"
            f"Keywords: {', '.join(self.keywords[:20]) or 'N/A'}\n"
            f"Publication Types: {', '.join(self.publication_types[:10]) or 'N/A'}\n"
            f"PubMed URL: {self.pubmed_url}\nAbstract:\n{self.abstract or '[No abstract available]'}\n"
        )


class PubMedClient:
    BASE = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils'
    def __init__(self, email: str = PUBMED_TOOL_EMAIL, tool: str = PUBMED_TOOL_NAME, api_key: Optional[str] = None):
        self.email = email
        self.tool = tool
        self.api_key = api_key or os.getenv('NCBI_API_KEY', '')

    def _get(self, endpoint: str, params: Dict[str, Any], retries: int = 3) -> str:
        params = dict(params)
        params.update({'tool': self.tool, 'email': self.email})
        if self.api_key:
            params['api_key'] = self.api_key
        url = f"{self.BASE}/{endpoint}?{urllib.parse.urlencode(params)}"
        last = None
        for i in range(retries):
            try:
                req = urllib.request.Request(url, headers={'User-Agent': f'{self.tool} ({self.email})'})
                with urllib.request.urlopen(req, timeout=45) as r:
                    return r.read().decode('utf-8', errors='ignore')
            except Exception as e:
                last = e
                wait = min(2 ** i, 8)
                print(f'⚠️ PubMed 请求失败，{wait}s 后重试: {e}')
                time.sleep(wait)
        raise RuntimeError(f'PubMed API 请求失败: {last}')

    def search(self, query: str, max_results: int, year_from: Optional[int], year_to: Optional[int]) -> List[str]:
        params = {'db': 'pubmed', 'term': query, 'retmode': 'json', 'retmax': int(max_results), 'sort': 'relevance'}
        if year_from or year_to:
            params['datetype'] = 'pdat'
            if year_from: params['mindate'] = str(year_from)
            if year_to: params['maxdate'] = str(year_to)
        data = json.loads(self._get('esearch.fcgi', params))
        return [str(x) for x in data.get('esearchresult', {}).get('idlist', [])]

    def fetch_records(self, pmids: Sequence[str], batch_size: int = 50) -> List[PubMedRecord]:
        out: List[PubMedRecord] = []
        for i in range(0, len(pmids), batch_size):
            batch = pmids[i:i+batch_size]
            if not batch: continue
            xml = self._get('efetch.fcgi', {'db': 'pubmed', 'id': ','.join(batch), 'retmode': 'xml'})
            out.extend(parse_pubmed_xml(xml))
        return out

    def pmid_to_pmcid_elink(self, pmid: str) -> str:
        try:
            xml = self._get('elink.fcgi', {'dbfrom': 'pubmed', 'db': 'pmc', 'id': pmid, 'retmode': 'xml'}, retries=2)
            root = ET.fromstring(xml)
            for node in root.findall('.//LinkSetDb/Link/Id'):
                if node.text:
                    return 'PMC' + node.text.strip()
        except Exception:
            return ''
        return ''


def node_text(node: Optional[ET.Element]) -> str:
    return normalize_text(''.join(node.itertext())) if node is not None else ''

def parse_pubmed_xml(xml_text: str) -> List[PubMedRecord]:
    root = ET.fromstring(xml_text)
    records: List[PubMedRecord] = []
    for article in root.findall('.//PubmedArticle'):
        pmid = node_text(article.find('.//MedlineCitation/PMID'))
        title = node_text(article.find('.//Article/ArticleTitle'))
        abstracts = []
        for ab in article.findall('.//Article/Abstract/AbstractText'):
            label = ab.attrib.get('Label', '')
            txt = node_text(ab)
            if txt:
                abstracts.append(f'{label}: {txt}' if label else txt)
        abstract = '\n'.join(abstracts)
        journal = node_text(article.find('.//Article/Journal/Title'))
        year = node_text(article.find('.//Article/Journal/JournalIssue/PubDate/Year'))
        if not year:
            md = node_text(article.find('.//Article/Journal/JournalIssue/PubDate/MedlineDate'))
            m = re.search(r'\b(19|20)\d{2}\b', md)
            year = m.group(0) if m else ''
        authors = []
        for au in article.findall('.//Article/AuthorList/Author'):
            collective = node_text(au.find('CollectiveName'))
            last = node_text(au.find('LastName'))
            fore = node_text(au.find('ForeName'))
            if collective: authors.append(collective)
            elif last or fore: authors.append(normalize_text(f'{fore} {last}'))
        keywords = [node_text(k) for k in article.findall('.//KeywordList/Keyword') if node_text(k)]
        pubtypes = [node_text(p) for p in article.findall('.//PublicationTypeList/PublicationType') if node_text(p)]
        article_ids: Dict[str, str] = {}
        doi = ''
        pmcid = ''
        for aid in article.findall('.//PubmedData/ArticleIdList/ArticleId'):
            typ = aid.attrib.get('IdType', '').lower()
            val = node_text(aid)
            if typ and val:
                article_ids[typ] = val
            if typ == 'doi': doi = val
            if typ in {'pmc', 'pmcid'}: pmcid = val
        if title or abstract:
            records.append(PubMedRecord(pmid, title, abstract, journal, year, doi, pmcid, authors, keywords, pubtypes, article_ids))
    return records


class FullTextFetcher:
    def __init__(self, pubmed: PubMedClient, cache_dir: Path = DEFAULT_FULLTEXT_CACHE):
        self.pubmed = pubmed
        self.cache_dir = cache_dir

    def fetch_for_record(self, record: PubMedRecord) -> Dict[str, Any]:
        paper_dir = self.cache_dir / (record.pmid or record.title_hash)
        paper_dir.mkdir(parents=True, exist_ok=True)
        (paper_dir / 'pubmed_record.json').write_text(json_dumps(asdict(record), 2), encoding='utf-8')
        pmcid = record.pmcid or self.pubmed.pmid_to_pmcid_elink(record.pmid)
        if pmcid and not pmcid.upper().startswith('PMC'):
            pmcid = 'PMC' + pmcid
        status = 'open_fulltext_not_found'
        source = 'none'
        raw_path = ''
        fulltext_text = ''
        sections: Dict[str, str] = {}
        links: List[str] = []
        if pmcid:
            try:
                xml = self.pubmed._get('efetch.fcgi', {'db': 'pmc', 'id': pmcid.replace('PMC',''), 'retmode': 'xml'}, retries=2)
                if '<article' in xml or '<pmc-articleset' in xml:
                    raw = paper_dir / 'PMC_EFetch_XML.xml'
                    raw.write_text(xml, encoding='utf-8')
                    raw_path = str(raw)
                    source = 'PMC_EFetch_XML'
                    fulltext_text, sections, links = parse_fulltext_xml(xml)
                    status = 'open_fulltext_found' if fulltext_text.strip() else 'open_fulltext_xml_empty'
            except Exception as e:
                (paper_dir / 'pmc_fetch_error.txt').write_text(str(e), encoding='utf-8')
        # Europe PMC fallback
        if not fulltext_text.strip() and record.pmid:
            try:
                url = f"https://www.ebi.ac.uk/europepmc/webservices/rest/{record.pmid}/fullTextXML"
                req = urllib.request.Request(url, headers={'User-Agent': 'amp_benchmark_fulltext_global_meeting'})
                with urllib.request.urlopen(req, timeout=45) as r:
                    xml = r.read().decode('utf-8', errors='ignore')
                if '<article' in xml or '<body' in xml:
                    raw = paper_dir / 'EuropePMC_fullTextXML.xml'
                    raw.write_text(xml, encoding='utf-8')
                    raw_path = str(raw)
                    source = 'EuropePMC_fullTextXML'
                    fulltext_text, sections, links = parse_fulltext_xml(xml)
                    status = 'open_fulltext_found' if fulltext_text.strip() else 'open_fulltext_xml_empty'
            except Exception as e:
                (paper_dir / 'europepmc_fetch_error.txt').write_text(str(e), encoding='utf-8')
        # Always save parsed files
        (paper_dir / 'fulltext_text.txt').write_text(fulltext_text, encoding='utf-8')
        (paper_dir / 'fulltext_sections.json').write_text(json_dumps(sections, 2), encoding='utf-8')
        (paper_dir / 'links.json').write_text(json_dumps(links, 2), encoding='utf-8')
        meta = {
            'pmid': record.pmid, 'pmcid': pmcid, 'doi': record.doi, 'title': record.title,
            'status': status, 'source': source, 'raw_path': raw_path, 'cache_dir': str(paper_dir),
            'num_chars': len(fulltext_text), 'num_links': len(links), 'fetched_at': now_str(),
        }
        (paper_dir / 'fulltext_metadata.json').write_text(json_dumps(meta, 2), encoding='utf-8')
        return {'record': asdict(record), 'fulltext': meta, 'sections': sections, 'links': links, 'fulltext_excerpt': truncate(fulltext_text, 30000)}


def parse_fulltext_xml(xml_text: str) -> Tuple[str, Dict[str, str], List[str]]:
    try:
        root = ET.fromstring(xml_text)
    except Exception:
        return '', {}, []
    # remove refs/tables? keep text simple
    sections: Dict[str, str] = {}
    texts: List[str] = []
    links: List[str] = []
    for ext in root.findall('.//ext-link'):
        href = ext.attrib.get('{http://www.w3.org/1999/xlink}href') or ext.attrib.get('href') or ''.join(ext.itertext())
        if href and href not in links:
            links.append(normalize_text(href))
    url_re = re.compile(r'https?://[^\s\)\]\}\<\>"\']+')
    # Article title/abstract/body sections
    for sec in root.findall('.//sec'):
        title = node_text(sec.find('title')) or f'section_{len(sections)+1}'
        paras = []
        for p in sec.findall('.//p'):
            t = node_text(p)
            if t: paras.append(t)
        if paras:
            content = '\n'.join(paras)
            key = normalize_key(title) or f'section_{len(sections)+1}'
            sections[key] = content
            texts.append(f'## {title}\n{content}')
            for u in url_re.findall(content):
                if u not in links: links.append(u)
    if not texts:
        all_text = normalize_text(' '.join(root.itertext()))
        texts.append(all_text)
        for u in url_re.findall(all_text):
            if u not in links: links.append(u)
    return '\n\n'.join(texts), sections, links


class DeepSeekClient:
    def __init__(self, cfg: Dict[str, Any], model: Optional[str] = None):
        self.cfg = cfg
        self.model = model or cfg.get('meeting_model') or cfg.get('chat_model') or 'deepseek-v4-pro'
        key_env = cfg.get('chat_api_key_env', 'DASHSCOPE_API_KEY')
        api_key = os.getenv(key_env) or os.getenv('OPENAI_API_KEY')
        if not api_key:
            raise RuntimeError(f'没有找到 {key_env}。请在 .env 写入 {key_env}=你的key')
        base_url = cfg.get('chat_base_url') or os.getenv('OPENAI_BASE_URL') or 'https://dashscope.aliyuncs.com/compatible-mode/v1'
        self.client = OpenAI(api_key=api_key, base_url=base_url, timeout=float(os.getenv('LLM_TIMEOUT_SECONDS', '300')), max_retries=0)
        self.max_retries = int(os.getenv('LLM_MAX_RETRIES', '4'))

    def chat(self, agent: MarkdownAgent, prompt: str) -> str:
        kwargs = {
            'model': self.model,
            'messages': [{'role':'system','content':agent.system}, {'role':'user','content':prompt}],
            'temperature': agent.temperature,
        }
        if self.cfg.get('use_response_format', False) and agent.response_format == 'json_object':
            kwargs['response_format'] = {'type': 'json_object'}
        last = None
        for attempt in range(1, self.max_retries+1):
            try:
                print(f'       ↳ DeepSeek: agent={agent.agent_id}, model={self.model}, attempt={attempt}/{self.max_retries}')
                r = self.client.chat.completions.create(**kwargs)
                return r.choices[0].message.content or ''
            except Exception as e:
                last = e
                if attempt >= self.max_retries:
                    raise
                wait = min(5 * 2 ** (attempt - 1), 60)
                print(f'⚠️ DeepSeek 调用失败，{wait}s 后重试: {e}')
                time.sleep(wait)
        raise RuntimeError(f'DeepSeek 调用失败: {last}')

    def json_chat(self, agent: MarkdownAgent, prompt: str, failed_dir: Path, tag: str) -> Any:
        text = self.chat(agent, prompt)
        try:
            return safe_json_loads(text)
        except Exception as e:
            failed_dir.mkdir(parents=True, exist_ok=True)
            bad = failed_dir / f'{tag}_{agent.agent_id}_{int(time.time())}.txt'
            bad.write_text(text, encoding='utf-8')
            print(f'⚠️ {agent.agent_id} JSON 解析失败，尝试自动修复。原文已保存: {bad}')
            repair_agent = MarkdownAgent('json_repair', '你是 JSON 修复器。只输出严格 JSON，不输出解释。', '$bad_json', 0.0, 'json_object')
            repaired = self.chat(repair_agent, '请把下面内容修复成严格 JSON。不要补充事实，只修复格式。\n\n' + text)
            try:
                return safe_json_loads(repaired)
            except Exception:
                bad2 = failed_dir / f'{tag}_{agent.agent_id}_repair_failed_{int(time.time())}.txt'
                bad2.write_text(repaired, encoding='utf-8')
                raise RuntimeError(f'{agent.agent_id} JSON 修复失败: {e}; repaired saved={bad2}')


def looks_relevant(r: PubMedRecord) -> bool:
    text = f'{r.title}\n{r.abstract}\n{" ".join(r.keywords)}'.lower()
    has_amp = any(k in text for k in ['antimicrobial peptide', 'antimicrobial peptides', 'host defense peptide', ' amp ', 'amps'])
    has_topic = any(k in text for k in ['predict', 'classifier', 'classification', 'machine learning', 'deep learning', 'benchmark', 'dataset', 'database', 'evaluation', 'web server', 'model'])
    return has_amp and has_topic

def unique_records(records: Sequence[PubMedRecord]) -> List[PubMedRecord]:
    seen = set(); out = []
    for r in records:
        key = r.pmid or normalize_key(r.doi) or r.title_hash
        if key not in seen:
            seen.add(key); out.append(r)
    return out

def chunked(items: Sequence[Any], n: int) -> Iterable[List[Any]]:
    for i in range(0, len(items), n): yield list(items[i:i+n])


class LiteratureMemory:
    def __init__(self, md_path: Path, json_path: Path, index_path: Path):
        self.md_path = md_path; self.json_path = json_path; self.index_path = index_path
        self.index = self._load_index(); self.memory_json = self._load_json(); self._ensure_md()
    def _load_index(self):
        if self.index_path.exists():
            try: return json.loads(self.index_path.read_text(encoding='utf-8'))
            except Exception: pass
        return {'processed_pmids': [], 'processed_dois': [], 'processed_title_hashes': [], 'known_model_keys': [], 'known_dataset_keys': [], 'known_metric_keys': [], 'runs': []}
    def _load_json(self):
        if self.json_path.exists():
            try: return json.loads(self.json_path.read_text(encoding='utf-8'))
            except Exception: pass
        return {'models': [], 'datasets': [], 'metrics': [], 'papers': [], 'benchmark_implications': [], 'open_questions': [], 'runs': []}
    def _ensure_md(self):
        ensure_parent(self.md_path)
        if not self.md_path.exists():
            self.md_path.write_text(f'# Literature Memory\n\nCreated: {now_str()}\n', encoding='utf-8')
    def save(self):
        ensure_parent(self.index_path); ensure_parent(self.json_path)
        self.index_path.write_text(json_dumps(self.index, 2), encoding='utf-8')
        self.json_path.write_text(json_dumps(self.memory_json, 2), encoding='utf-8')
    def read_context(self, max_chars: int = 30000) -> str:
        if not self.md_path.exists(): return ''
        text = self.md_path.read_text(encoding='utf-8', errors='ignore')
        return text[-max_chars:]
    def has_processed(self, r: PubMedRecord) -> bool:
        return (r.pmid in set(self.index.get('processed_pmids', [])) or
                (r.doi and normalize_key(r.doi) in set(self.index.get('processed_dois', []))) or
                r.title_hash in set(self.index.get('processed_title_hashes', [])))
    def mark_processed(self, records: Sequence[PubMedRecord]):
        pmids=set(self.index.setdefault('processed_pmids', [])); dois=set(self.index.setdefault('processed_dois', [])); th=set(self.index.setdefault('processed_title_hashes', []))
        for r in records:
            if r.pmid: pmids.add(r.pmid)
            if r.doi: dois.add(normalize_key(r.doi))
            if r.title: th.add(r.title_hash)
        self.index['processed_pmids']=sorted(pmids); self.index['processed_dois']=sorted(dois); self.index['processed_title_hashes']=sorted(th)
    def merge_final(self, final_data: Dict[str, Any], records: Sequence[PubMedRecord], run_info: Dict[str, Any]):
        # Simple de-dup by canonical/name
        for key, list_name, known_key in [('models','models','known_model_keys'), ('datasets','datasets','known_dataset_keys'), ('metrics','metrics','known_metric_keys')]:
            existing = {normalize_key(x.get('canonical_name') or x.get('model_name') or x.get('dataset_name') or x.get('metric_name') or x.get('name') or '') for x in self.memory_json.setdefault(list_name, [])}
            known = set(self.index.setdefault(known_key, []))
            for item in final_data.get(list_name, []) or []:
                if not isinstance(item, dict): continue
                name = item.get('canonical_name') or item.get('model_name') or item.get('dataset_name') or item.get('metric_name') or item.get('name') or ''
                k = normalize_key(name) or stable_hash(json_dumps(item, sort_keys=True))
                if k not in existing:
                    self.memory_json[list_name].append(item); existing.add(k); known.add(k)
            self.index[known_key]=sorted(known)
        for list_name in ['papers','benchmark_implications','open_questions']:
            self.memory_json.setdefault(list_name, []).extend(final_data.get(list_name, []) or [])
        self.memory_json.setdefault('runs', []).append(run_info)
        self.index.setdefault('runs', []).append(run_info)
        self.mark_processed(records)
        self.append_md(final_data, records, run_info)
        self.save()
    def append_md(self, final_data: Dict[str, Any], records: Sequence[PubMedRecord], run_info: Dict[str, Any]):
        md = render_memory_md(final_data, records, run_info)
        with open(self.md_path, 'a', encoding='utf-8') as f:
            f.write('\n\n' + md + '\n')


def render_table(items: List[Dict[str, Any]], cols: List[str]) -> str:
    if not items: return '_无_\n'
    out = ['| ' + ' | '.join(cols) + ' |', '| ' + ' | '.join(['---']*len(cols)) + ' |']
    for it in items:
        row=[]
        for c in cols:
            v=it.get(c,'')
            if isinstance(v,(list,dict)): v=json_dumps(v)
            row.append(normalize_text(str(v)).replace('|','\\|')[:400])
        out.append('| ' + ' | '.join(row) + ' |')
    return '\n'.join(out)+'\n'

def render_memory_md(final_data: Dict[str, Any], records: Sequence[PubMedRecord], run_info: Dict[str, Any]) -> str:
    papers = '\n'.join([f'- PMID `{r.pmid}` PMCID `{r.pmcid or "N/A"}` DOI `{r.doi or "N/A"}` [{r.title}]({r.pubmed_url})' for r in records])
    return f"""---

## Global Meeting Result: {now_str()}

### Run Info
```json
{json_dumps(run_info, 2)}
```

### Papers
{papers}

### Models
{render_table(final_data.get('models', []) or [], ['canonical_name','model_name','code_repository_url','web_server_url','model_weights_url','benchmark_candidate','candidate_reason','blocking_issues','evidence_level','evidence_source','needs_full_text_verification','source_pmid','source_doi'])}

### Datasets
{render_table(final_data.get('datasets', []) or [], ['canonical_name','dataset_name','dataset_url','dataset_source','download_or_availability_signal','positive_definition','negative_definition','dataset_risks','evidence_level','source_pmid','source_doi'])}

### Metrics
{render_table(final_data.get('metrics', []) or [], ['metric_name','recommended_weight','why_useful_for_amp_screening','risk_or_limitation','evidence_level','source_pmid'])}

### Benchmark Implications
{render_table(final_data.get('benchmark_implications', []) or [], ['topic','decision','reason','evidence'])}

### Open Questions
{render_table(final_data.get('open_questions', []) or [], ['question','why_it_matters','suggested_next_action'])}
"""


def build_records_context(records: Sequence[PubMedRecord]) -> str:
    return '\n\n'.join([f'### Paper {i}\n{r.to_context()}' for i, r in enumerate(records, 1)])

def build_fulltext_context(fulltext_items: Sequence[Dict[str, Any]], max_chars_each: int = 20000) -> str:
    blocks=[]
    for i, item in enumerate(fulltext_items,1):
        rec=item.get('record',{})
        ft=item.get('fulltext',{})
        blocks.append(
            f"### FullText Evidence {i}\nPMID: {rec.get('pmid')}\nTitle: {rec.get('title')}\n"
            f"Status: {ft.get('status')} | Source: {ft.get('source')} | PMCID: {ft.get('pmcid')}\n"
            f"Cache Dir: {ft.get('cache_dir')}\nLinks: {json_dumps(item.get('links', [])[:50])}\n"
            f"Fulltext Excerpt:\n{truncate(item.get('fulltext_excerpt',''), max_chars_each)}"
        )
    return '\n\n'.join(blocks)

def build_evidence_pool_context(evidence_items: Sequence[Dict[str, Any]], max_chars: int = 120000) -> str:
    text = json_dumps(evidence_items, 2)
    return truncate(text, max_chars)


def run_query_planner(client: DeepSeekClient, agent_dir: Path, max_queries: int = 4) -> List[str]:
    agents=load_markdown_agents(agent_dir); agent=agents['pubmed_query_planner']
    data=client.json_chat(agent, agent.render(max_queries=max_queries), DEFAULT_FAILED_DIR, 'query_planner')
    queries=data.get('queries', []) if isinstance(data, dict) else []
    queries=[q.get('query','') if isinstance(q,dict) else str(q) for q in queries]
    queries=[q.strip() for q in queries if q and q.strip()]
    return queries[:max_queries] or FALLBACK_QUERIES

def run_info_extractor(client: DeepSeekClient, agent_dir: Path, records: Sequence[PubMedRecord], fulltext_items: Sequence[Dict[str, Any]], batch_no: int) -> Dict[str, Any]:
    agents=load_markdown_agents(agent_dir); agent=agents['info_extractor_agent']
    prompt=agent.render(records_context=build_records_context(records), fulltext_context=build_fulltext_context(fulltext_items))
    return client.json_chat(agent, prompt, DEFAULT_FAILED_DIR, f'batch{batch_no}_extract')

def run_global_meeting(client: DeepSeekClient, agent_dir: Path, records: Sequence[PubMedRecord], evidence_pool: Sequence[Dict[str, Any]], memory_context: str) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    agents=load_markdown_agents(agent_dir)
    rec_ctx=build_records_context(records)
    evidence_ctx=build_evidence_pool_context(evidence_pool)
    print('    -> [Global Agent 1] 模型与数据集专家全局会议...')
    md_json=client.json_chat(agents['model_dataset_agent'], agents['model_dataset_agent'].render(records_context=rec_ctx, evidence_pool=evidence_ctx, memory_context=memory_context), DEFAULT_FAILED_DIR, 'global_model_dataset')
    print('    -> [Global Agent 2] 指标专家全局会议...')
    metric_json=client.json_chat(agents['metric_agent'], agents['metric_agent'].render(records_context=rec_ctx, evidence_pool=evidence_ctx, memory_context=memory_context), DEFAULT_FAILED_DIR, 'global_metric')
    print('    -> [Global Agent 3] Critic 全局证据审查...')
    critic_text=client.chat(agents['critic_agent'], agents['critic_agent'].render(records_context=rec_ctx, evidence_pool=evidence_ctx, model_dataset_json=json_dumps(md_json,2), metric_json=json_dumps(metric_json,2), memory_context=memory_context))
    print('    -> [Global Agent 4] Chief 汇总最终全局记忆 JSON...')
    chief_json=client.json_chat(agents['chief_agent'], agents['chief_agent'].render(records_context=rec_ctx, evidence_pool=evidence_ctx, model_dataset_json=json_dumps(md_json,2), metric_json=json_dumps(metric_json,2), critic_md=critic_text, memory_context=memory_context), DEFAULT_FAILED_DIR, 'global_chief')
    raw={'model_dataset_agent': md_json, 'metric_agent': metric_json, 'critic_agent_markdown': critic_text, 'chief_agent': chief_json}
    return chief_json, raw


def write_evidence_pool_files(evidence_items: List[Dict[str, Any]], path_json: Path, path_md: Path) -> None:
    ensure_parent(path_json); ensure_parent(path_md)
    path_json.write_text(json_dumps(evidence_items, 2), encoding='utf-8')
    parts=['# Evidence Pool\n', f'Generated: {now_str()}\n', f'Total evidence batches: {len(evidence_items)}\n']
    for i,e in enumerate(evidence_items,1):
        parts.append(f'\n## Evidence Batch {i}\n')
        parts.append('```json\n'+json_dumps(e,2)[:20000]+'\n```\n')
    path_md.write_text('\n'.join(parts), encoding='utf-8')


def run_pipeline(
    max_results: int,
    batch_size: int,
    year_from: Optional[int],
    year_to: Optional[int],
    provider: str,
    provider_config: Path,
    planner_agent_dir: Path,
    meeting_agent_dir: Path,
    fetch_fulltext: bool,
    no_planner: bool,
    reprocess: bool,
    max_queries: int,
) -> Dict[str, Any]:
    cfg=load_provider_config(provider_config, provider)
    client=DeepSeekClient(cfg)
    pubmed=PubMedClient()
    memory=LiteratureMemory(DEFAULT_MEMORY_MD, DEFAULT_MEMORY_JSON, DEFAULT_MEMORY_INDEX)
    print('\n========== [DeepSeek PubMed + Open FullText + GLOBAL Meeting v2] ==========')
    print(f'>>> Provider: {provider}')
    print(f'>>> Meeting Model: {client.model}')
    print(f'>>> Fetch open full text: {fetch_fulltext}')
    print('>>> Meeting mode: GLOBAL_ONLY_AFTER_ALL_EVIDENCE')
    if no_planner:
        queries=FALLBACK_QUERIES[:max_queries]
    else:
        print('\n>>> DeepSeek 正在规划 PubMed queries...')
        queries=run_query_planner(client, planner_agent_dir, max_queries=max_queries)
    print('\n>>> PubMed Queries:')
    for q in queries: print('   - ' + q)
    all_pmids=[]; per_query=[]
    for q in queries:
        ids=pubmed.search(q, max_results, year_from, year_to)
        print(f'    -> PubMed 返回 PMID 数量: {len(ids)}')
        per_query.append({'query':q, 'pmids':ids}); all_pmids.extend(ids)
    all_pmids=list(dict.fromkeys(all_pmids))
    ensure_parent(DEFAULT_PUBMED_SEARCH_JSON)
    DEFAULT_PUBMED_SEARCH_JSON.write_text(json_dumps({'time':now_str(), 'queries':per_query, 'unique_pmids':all_pmids},2), encoding='utf-8')
    print(f'>>> 去重后 PMID 总数: {len(all_pmids)}')
    records=unique_records(pubmed.fetch_records(all_pmids))
    before=len(records); records=[r for r in records if looks_relevant(r)]
    print(f'>>> AMP/模型/benchmark 轻量过滤: {before} -> {len(records)}')
    ensure_parent(DEFAULT_PUBMED_RECORDS_JSONL)
    for r in records: append_jsonl(DEFAULT_PUBMED_RECORDS_JSONL, asdict(r))
    if reprocess:
        new_records=records; skipped=0
    else:
        new_records=[r for r in records if not memory.has_processed(r)]; skipped=len(records)-len(new_records)
    print(f'>>> 记忆跳过已处理文献: {skipped}')
    print(f'>>> 本轮待处理文献: {len(new_records)}')
    if not new_records:
        return {'status':'no_new_records','num_total_records':len(records),'num_new_records':0}
    fetcher=FullTextFetcher(pubmed)
    all_evidence=[]; all_fulltext=[]; failed=[]
    for batch_no,batch in enumerate(chunked(new_records,batch_size),1):
        print(f'\n========== [Evidence Collection Batch {batch_no}] 处理 {len(batch)} 篇 ==========', flush=True)
        print('    -> [Step 1] 获取并保存开放全文证据（PMC / Europe PMC）...')
        fulltext_items=[]
        for r in batch:
            if fetch_fulltext:
                item=fetcher.fetch_for_record(r)
            else:
                paper_dir=DEFAULT_FULLTEXT_CACHE/(r.pmid or r.title_hash); paper_dir.mkdir(parents=True, exist_ok=True)
                (paper_dir/'pubmed_record.json').write_text(json_dumps(asdict(r),2), encoding='utf-8')
                item={'record':asdict(r),'fulltext':{'pmid':r.pmid,'status':'disabled','source':'no_fulltext','cache_dir':str(paper_dir)},'sections':{},'links':[],'fulltext_excerpt':''}
            fulltext_items.append(item); all_fulltext.append(item)
            ft=item['fulltext']; print(f"       PMID {r.pmid}: {ft.get('status')} | {ft.get('source')} | PMCID={ft.get('pmcid') or r.pmcid or 'N/A'} | cache={ft.get('cache_dir')}")
        print('    -> [Step 2] DeepSeek 提取关键信息 evidence...')
        try:
            ev=run_info_extractor(client, meeting_agent_dir, batch, fulltext_items, batch_no)
            ev_wrapper={'batch_no':batch_no,'time':now_str(),'pmids':[r.pmid for r in batch],'evidence':ev,'fulltext_cache_dirs':[it['fulltext'].get('cache_dir') for it in fulltext_items]}
            all_evidence.append(ev_wrapper)
            append_jsonl(DEFAULT_EVIDENCE_JSONL, ev_wrapper)
            print('    -> [Step 3] 保存 evidence，暂不开会。')
            print('       ✅ 本批证据已保存，不进行多 Agent 会议。')
        except Exception as e:
            failed.append({'batch_no':batch_no,'pmids':[r.pmid for r in batch],'error':str(e)})
            DEFAULT_FAILED_DIR.mkdir(parents=True, exist_ok=True)
            (DEFAULT_FAILED_DIR/f'batch{batch_no}_failed.txt').write_text(str(e), encoding='utf-8')
            print(f'       ⚠️ Batch {batch_no} evidence 提取失败，跳过该批但不中断: {e}')
    print('\n========== [Evidence Collection Finished] ==========', flush=True)
    print(f'>>> Evidence batches collected: {len(all_evidence)}')
    print(f'>>> Failed evidence batches: {len(failed)}')
    write_evidence_pool_files(all_evidence, DEFAULT_EVIDENCE_POOL_JSON, DEFAULT_EVIDENCE_POOL_MD)
    print(f'>>> Evidence pool saved: {DEFAULT_EVIDENCE_POOL_JSON} / {DEFAULT_EVIDENCE_POOL_MD}')
    if not all_evidence:
        return {'status':'no_evidence_collected','num_failed_batches':len(failed)}
    print('\n========== [Global Meeting] 所有文章证据收集完成，开始一次性全局多 Agent 会议 ==========', flush=True)
    final_data, raw = run_global_meeting(client, meeting_agent_dir, new_records, all_evidence, memory.read_context())
    append_jsonl(DEFAULT_MEETING_RAW_JSONL, {'time':now_str(),'mode':'global','raw':raw,'pmids':[r.pmid for r in new_records]})
    print('    -> [Write Memory] 写入 MD + JSON 长期记忆...')
    run_info={'time':now_str(),'mode':'global','num_records':len(new_records),'num_evidence_batches':len(all_evidence),'num_failed_batches':len(failed),'queries':queries,'fetch_fulltext':fetch_fulltext}
    memory.merge_final(final_data, new_records, run_info)
    return {'status':'ok','memory_md_path':str(DEFAULT_MEMORY_MD),'memory_json_path':str(DEFAULT_MEMORY_JSON),'memory_index_path':str(DEFAULT_MEMORY_INDEX),'evidence_jsonl':str(DEFAULT_EVIDENCE_JSONL),'evidence_pool_json':str(DEFAULT_EVIDENCE_POOL_JSON),'evidence_pool_md':str(DEFAULT_EVIDENCE_POOL_MD),'meeting_raw_jsonl':str(DEFAULT_MEETING_RAW_JSONL),'fulltext_cache_dir':str(DEFAULT_FULLTEXT_CACHE),'num_total_records':len(records),'num_new_records':len(new_records),'num_evidence_batches':len(all_evidence),'num_failed_batches':len(failed)}


def parse_args() -> argparse.Namespace:
    p=argparse.ArgumentParser(description='DeepSeek PubMed + Open FullText + Global Meeting v2')
    current_year=_dt.datetime.now().year
    p.add_argument('--max-results', type=int, default=10, help='每个 PubMed query 最多返回多少篇')
    p.add_argument('--batch-size', type=int, default=5, help='证据提取阶段每批多少篇；会议总是最后全局一次')
    p.add_argument('--year-from', type=int, default=current_year-5)
    p.add_argument('--year-to', type=int, default=current_year)
    p.add_argument('--provider', default=DEFAULT_PROVIDER)
    p.add_argument('--provider-config', default=str(DEFAULT_PROVIDER_CONFIG))
    p.add_argument('--planner-agent-dir', default=str(DEFAULT_PLANNER_AGENT_DIR))
    p.add_argument('--meeting-agent-dir', default=str(DEFAULT_MEETING_AGENT_DIR))
    p.add_argument('--max-queries', type=int, default=4)
    p.add_argument('--no-planner', action='store_true')
    p.add_argument('--no-fulltext', action='store_true')
    p.add_argument('--reprocess', action='store_true')
    return p.parse_args()

def main() -> None:
    args=parse_args()
    result=run_pipeline(max_results=args.max_results,batch_size=args.batch_size,year_from=args.year_from,year_to=args.year_to,provider=args.provider,provider_config=Path(args.provider_config),planner_agent_dir=Path(args.planner_agent_dir),meeting_agent_dir=Path(args.meeting_agent_dir),fetch_fulltext=not args.no_fulltext,no_planner=args.no_planner,reprocess=args.reprocess,max_queries=args.max_queries)
    print('\n'+'='*72)
    print('✅ Pipeline finished')
    print('='*72)
    for k,v in result.items(): print(f'{k}: {v}')

if __name__=='__main__':
    main()
