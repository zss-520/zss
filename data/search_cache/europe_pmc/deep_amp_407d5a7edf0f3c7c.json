      {
        "id": "PPR395519",
        "source": "PPR",
        "doi": "10.21203/rs.3.rs-889572/v1",
        "title": "Recommender System for Telecom Packages Based on the Deep &amp; Cross Network",
        "authorString": "Shi C, Wang W, Wei S, Lv F.",
        "authorList": {
          "author": [
            {
