# Conda 初始化脚本
CONDA_SH_PATH=/share/home/zhangss/miniconda3/etc/profile.d/conda.sh

# =========================
# 主控环境 / 已有基础环境
# =========================
# 这是你当前主控评测环境
VLAB_ENV=eval_env

# 下面三个是你已经存在的基座环境名，不是路径
MACREL_ENV=base_pt2
AMPSCANNER_ENV=base_tf

# 这三个基座环境会被自动克隆成模型自己的 env_xxx
# base_pt1 -> 适合老版 torch / pytorch1
# base_pt2 -> 适合新版 torch / transformers
# base_tf  -> 适合 tensorflow
HPC_BASE_ENV_MAP={"tensorflow":["base_tf"],"torch1":["base_pt1"],"torch2":["base_pt2"],"generic":[]}

# =========================
# 模型命令
# =========================
MACREL_CMD=macrel
AMPSCANNER_CMD=python /share/home/zhangss/amp-scanner-v2/amp_scanner_v2_predict_tf1.py

# =========================
# Slurm
# =========================
SLURM_PARTITION=gpu
SLURM_JOB_NAME=amp_eval
SLURM_GPUS=1
SLURM_CPUS_PER_TASK=20

# =========================
# pip 镜像
# =========================
PIP_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
PIP_EXTRA_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# =========================
# 会议与阶段产物
# =========================
MEETING_OUTPUT_DIR=meeting_outputs
FIRST_MEETING_NAME=meeting_stage1_model_run
SECOND_MEETING_NAME=meeting_stage2_eval_codegen
FIRST_STAGE_PY_NAME=stage1_model_runner.py
FIRST_STAGE_SH_NAME=stage1_run_model.sh
SECOND_STAGE_PY_NAME=stage2_eval_script.py
SECOND_STAGE_SH_NAME=stage2_run_eval.sh
FIRST_STAGE_OBSERVATION_TXT=stage1_observation.txt

# =========================
# HPC 远端仓库 / 复用策略
# =========================
DEFAULT_PYTHON_VERSION=3.9

HPC_REMOTE_REPO_ROOT=/share/home/zhangss/repos

HPC_EXISTING_MODEL_ROOTS=/share/home/zhangss/repos,/share/home/zhangss/base_models,/share/home/zhangss/models,/share/home/zhangss
# 如果你已经明确知道某些模型的远端目录，可以写在这里
# 没有就先保持 {}
# 更推荐把“已复现模型”维护在 data/local_registry.json 中
HPC_PREBUILT_REPO_MAP={}

# 自动优先复用远端已有模型目录
AUTO_USE_EXISTING_REMOTE_MODEL=1

# 自动做小样本 smoke test
AUTO_RUN_MODEL_SMOKE_TEST=1
MINI_TEST_FASTA_NAME=vlab_mini_test.fasta
MINI_TEST_OUTPUT_ROOT=mini_test_outputs
MINI_TEST_FASTA_CONTENT=>mini_seq_1\nACDEFGHIKLMNPQRSTVWY\n>mini_seq_2\nKLLKLLKLLKLL\n

# =========================
# 本次要评测的模型
# main.py 会优先读这里
# =========================
TARGET_MODEL_NAMES=AMP-Scanner-v2,Macrel,amPEPpy,AI4AMP,AMPlify

# =========================
# 说明
# =========================
# 1) data/local_registry.json 里已经 skip_env_setup=true 的模型，不会再次复现
# 2) model_knowledge_db.json 里不在注册表中的模型，才会进入自动部署
# 3) HPC_PREBUILT_REPO_MAP 只是辅助；真正“已复现”判断优先看 local_registry.json