# Copy this file to .env and fill values locally. Never commit .env.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=
SERPAPI_KEY=

HPC_HOST=
HPC_PORT=22
HPC_USER=
HPC_PASS=
HPC_TARGET_DIR=/share/home/USER/vlab_workspace
HPC_REMOTE_REPO_ROOT=/share/home/USER/repos
HPC_EXISTING_MODEL_ROOTS=
HPC_PREBUILT_REPO_MAP={}
CONDA_SH_PATH=/share/home/USER/miniconda3/etc/profile.d/conda.sh
VLAB_ENV=eval_env

SLURM_PARTITION=gpu
SLURM_JOB_NAME=amp_eval
SLURM_GPUS=1
SLURM_CPUS_PER_TASK=20
SLURM_POLL_SECONDS=15
SLURM_JOB_TIMEOUT_SECONDS=21600
SLURM_SACCT_RETRIES=6
SLURM_SACCT_RETRY_SECONDS=5

PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
DEFAULT_PYTHON_VERSION=3.9

AUTO_USE_EXISTING_REMOTE_MODEL=1
AUTO_RUN_MODEL_SMOKE_TEST=1
MINI_TEST_FASTA_NAME=vlab_mini_test.fasta
MINI_TEST_OUTPUT_ROOT=mini_test_outputs
MINI_TEST_FASTA_CONTENT=>mini_seq_1\nACDEFGHIKLMNPQRSTVWY\n>mini_seq_2\nKLLKLLKLLKLL\n

# Comma-separated model names, or ALL.
TARGET_MODEL_NAMES=

# Formal runs keep this disabled. Set to 1 only for explicit diagnostic runs.
ALLOW_UNVERIFIED_MODELS=0

# Deterministic scientific post-processing.
SCIENTIFIC_BOOTSTRAP_ITERATIONS=500
SCIENTIFIC_BOOTSTRAP_SEED=20260714

# Security opt-ins. Leave disabled until commands/host keys are reviewed.
HPC_ALLOW_UNTRUSTED_MODEL_SETUP_COMMANDS=0
HPC_ALLOW_UNKNOWN_HOST_KEY=0
